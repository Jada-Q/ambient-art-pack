node_modules/
.vercel/
.DS_Store

# Built pkg artifacts (regenerated by build-pkg.sh; published as GitHub release)
build/

# pkg-payload is staged from vendor/ at build time
pkg-payload/

# Ambient.app build artifacts (regenerated by ambient-app/build-app.sh)
ambient-app/build/

# Upstream zip (we keep the unpacked .saver under vendor/ as source of truth)
vendor/*.zip

# Vendor bundle (re-downloadable from upstream — keep tracked for reproducibility)
# Uncomment to fetch fresh each build:
# vendor/
bgm-demos/.venv/
bgm-demos/musicgen/*.wav
